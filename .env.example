DISCORD_TOKEN=
DISCORD_GUILD_ID=
BOT_PREFIX=!
# Start spoken requests with "Playboy".
# All AI endpoints are local. No Groq/OpenAI key is needed.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
# Modest context size for machines with limited GPU memory.
OLLAMA_CONTEXT=4096
LOCAL_AI_TIMEOUT_MS=180000
LOCAL_AUDIO_PORT=8765
# Run speech on CPU to leave GPU memory for chat. No CUDA setup needed here.
WHISPER_MODEL=base.en
WHISPER_THREADS=4
PIPER_VOICE=en_US-ryan-high
